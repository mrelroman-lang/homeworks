# templates/vector.yaml.j2
# Standard Vector configuration
api:
  enabled: true
  address: "127.0.0.1:8686"

sources:
  my_source_id:
    type: demo_logs  # <-- Используем demo_logs, а НЕ generate_logs
    interval: 1
    format: json     # <-- ОБЯЗАТЕЛЬНОЕ поле для demo_logs

sinks:
  my_sink_id:
    type: console
    inputs:
      - my_source_id
    encoding:
      codec: json