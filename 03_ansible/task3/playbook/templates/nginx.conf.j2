user {{ nginx_user_name | default('www-data') }};
worker_processes  1;

pid /run/nginx.pid;

events {
    worker_connections {{ nginx_worker_connections | default(1024) }};
    # multi_accept on;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;

    keepalive_timeout {{ nginx_keepalive_timeout | default(65) }};

    gzip {{ 'on' if nginx_gzip | default(true) else 'off' }};
    {% if nginx_gzip | default(true) %}
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_buffers 16 8k;
    gzip_http_version 1.1;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
    {% endif %}

    client_max_body_size {{ nginx_client_max_body_size | default('1m') }};

    # Логирование
    access_log {{ nginx_access_log | default('/var/log/nginx/access.log') }};
    error_log  {{ nginx_error_log | default('/var/log/nginx/error.log') }} warn;

    types_hash_max_size 2048;

    include /etc/nginx/conf.d/*.conf;
    include /etc/nginx/sites-enabled/*;
}
